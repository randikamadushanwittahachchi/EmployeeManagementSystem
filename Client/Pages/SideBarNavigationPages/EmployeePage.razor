@using Client.Helper.Constracts
@using Client.Helper.Implementations
@using ClientLibrary.Constants
@inject EmployeeModal employeeDialog
@inject MenuModal menuDialog
@inject IDialogModal dialog
@if (allState.ShowEmployee)
{
    <div class=" container mt-4">
        <div class="row">
            <div class=" col-12">
                <div class=" card">
                    <div class=" card-header">
                        <h4 class=" float-start fs-4 text-center m-0 ">Employee</h4>
                        <button type="button" class=" btn btn-out float-end" @onclick="Add"><i class="bi bi-person-add"></i></button>
                    </div>
                    <div class=" card-body" style=" overflow-x:hidden; overflow-y:scroll; max-height:390px ">
                        <table class=" table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">Image</th>
                                    <th scope="col">Civil Id</th>
                                    <th scope="col">File Name</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Telephone</th>
                                    <th scope="col">Job Name</th>
                                    <th scope="col">Branch</th>
                                    <th scope="col">Town</th>
                                    <th scope="col">Menu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Employees.Any())
                                {
                                    <tr>
                                        <td> No data is aviable </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach(var employee in Employees)
                                    {
                                        <tr>
                                            <td> <img src="@employee.Photo" style="height:20px;width:20px"/> </td>
                                            <td> @employee.CivilId</td>
                                            <td> @employee.FileName</td>
                                            <td> @employee.Name</td>
                                            <td> @employee.TelephoneNumber</td>
                                            <td> @employee.JobName</td>
                                            <td> @employee.Branch!.Name</td>
                                            <td> @employee.Town!.Name</td>
                                            <td> 
                                                <button type="button" class=" btn btn-link p-0 m-0 border-0 text-primary text-decoration-none " @onclick="() => Menu(employee)">
                                                    <i class="bi bi-list"></i>
                                                    <span>menu</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Employee> Employees { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;
        await GetAll();
    }

    // Get All Employees
    private async Task GetAll()
    {
        Employees = await employeeService.GetAll(ContantsBaseUrl.EmployeeUrl);
        allState.Action?.Invoke();
    }

    // Menu Employee
    private void Menu(Employee employee)
    {
        menuDialog.ShowDialog(employee);
    }

    // Creat New Employee
    private void Add()
    {
        employeeDialog.ShowDialog(AddEmployee, "Add", "Create");
    }
    private async Task AddEmployee(Employee employee)
    {
        var response = await employeeService.Create(employee, ContantsBaseUrl.EmployeeUrl);
        if (response.Flag) await GetAll();
        dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }



}
