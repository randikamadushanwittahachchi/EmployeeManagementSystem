@using Client.Helper.Constracts
@using Client.Helper.Implementations.VacationModals
@using ClientLibrary.Constants
@implements IDisposable
@inject VacationTypeModal vacationTypeDialog
@inject IDialogModal dialog
@if (allState.ShowVacationType)
{
    <div class=" container mt-4">
    <div class=" row">
        <div class=" col-12">
            <div class=" card">
                <div class=" card-header hstack justify-content-between">
                    <div class=" card-title fs-4 align-self-start">Vacation-Type</div>
                    <button type="button" class=" btn" @onclick="Add"><i class=" fs-3 bi bi-plus-circle"></i></button>
                </div>
                <div class=" card-body">
                    <table class=" table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Name</th>
                                <th scope="col">Edit</th>
                                <th scope="col">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!VacationTypes.Any())
                            {
                                <tr>
                                    <td class=" text-center" colspan="4">Data is not available now</td>
                                </tr>
                            }
                            else
                            {
                                var i = 0;
                                foreach(var vacationType in VacationTypes)
                                {
                                    <tr>
                                        <td>@(++i)</td>
                                        <td>@vacationType.Name</td>
                                        <td>
                                            <button type="button" class=" btn btn-primary" @onclick="()=>Edit(vacationType)">
                                                <i class=" bi bi-pencil-square"></i>
                                                Edit
                                            </button>
                                        </td>
                                        <td>
                                            <button type="button" class=" btn btn-primary" @onclick="()=>Delete(vacationType)">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
}

@code {

    private List<VacationType> VacationTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;
        await GetAll();

    }
    // Get All
    private async Task GetAll()
    {
        VacationTypes = await vacationTypeService.GetAll(ContantsBaseUrl.VacationTypeUrl);
        allState.Action!.Invoke();
    }
    // Add
    private void Add()
    {
        vacationTypeDialog.Show(AddVacationType, "Create", "Create");

    }
    private async Task AddVacationType(VacationType vacationType)
    {
        var response = await vacationTypeService.Create(vacationType, ContantsBaseUrl.VacationTypeUrl);
        if (response.Flag) await GetAll();
        dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);

    }
    // Edit
    private void Edit(VacationType vacationType)
    {
        vacationTypeDialog.Show(EditVacationType, vacationType, "Edit", "Edit");
    }
    private async Task EditVacationType(VacationType vacationType)
    {
        var response = await vacationTypeService.Update(vacationType, $"{ContantsBaseUrl.VacationTypeUrl}/{vacationType.Id}");
        if (response.Flag) await GetAll();
        dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }
    // Delete
    private void Delete(VacationType vacationType)
    {
        dialog.ShowDialog("Alert", "Are You Sure You Want to delete this vacation-type", () => DeleteVacationType(vacationType));
    }
    private async Task DeleteVacationType(VacationType vacationType)
    {
        var response = await vacationTypeService.DeleteById($"{ContantsBaseUrl.VacationTypeUrl}/{vacationType.Id}");
        if (response.Flag) await GetAll();
        dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }
    public void Dispose() => allState.Action -= StateHasChanged;

}
