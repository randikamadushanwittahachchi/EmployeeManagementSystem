@using BaseLibrary.Entities
@using BaseLibrary.Responses
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@implements IDisposable
@inject AllState allState
@inject IGenericModal<Town> TownDialog
@inject IDialogModal Dialog

@if(allState.ShowTown)
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="float-start fs-4 text-center m-0">Town</h4>
                        <button type="button" class="btn btn-out float-end" @onclick="Add"><i class="fs-3 bi bi-plus-circle"></i></button>
                    </div>
                    <div class="card-body" style="overflow-x:hidden; overflow-y:scroll; max-height:390px">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Town</th>
                                    <th scope="col">City</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Towns.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No data available</td>
                                    </tr>
                                }
                                else
                                {
                                    var i = 0;
                                    @foreach (var item in Towns)
                                    {
                                        <tr>
                                            <th scope="col">@(++i)</th>
                                            <td>@item.Name</td>
                                            <td>@(item.City?.Name ?? "None")</td>
                                            <td>
                                                <button type="button" class=" btn btn-primary" @onclick="() => Edit(item)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Edit</span>
                                                </button>
                                            </td>
                                            <td>
                                                <button type="button" class=" btn btn-primary" @onclick="() => Delete(item)">
                                                    <i class="bi bi-trash"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<style>
    a.text-decoration-none:hover, a.text-decoration-none:focus {
        text-decoration: underline;
    }
</style>

@code {
    public List<Town> Towns { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;

        await GetAll();

    }

    // Get All Town
    private async Task GetAll()
    {
        Towns = await townService.GetAll(ContantsBaseUrl.TownUrl);
        allState.Action?.Invoke();
    }

    // Add Town
    private void Add()
    {
        TownDialog.ShowDialog(AddTown, "Create", "Create");

    }
    private async Task AddTown(Town town)
    {
        var response = await townService.Create(town, ContantsBaseUrl.TownUrl);
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Edit Town
    private void Edit(Town town)
    {
        TownDialog.ShowDialog(EditTown, town, "Edit", "Edit");
    }
    private async Task EditTown(Town town)
    {
        var response = await townService.Update(town, $"{ContantsBaseUrl.TownUrl}/{town.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Delete Town
    private void Delete(Town town)
    {
        Dialog.ShowDialog("Alert", $"Are you sure you want to delete {town.Name}?", async () => await DeleteTown(town));
    }
    private async Task DeleteTown(Town town)
    {
        var response = await townService.DeleteById($"{ContantsBaseUrl.TownUrl}/{town.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }


    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}