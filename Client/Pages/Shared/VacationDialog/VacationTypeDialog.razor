@using Blazored.Modal
<div class=" modal fade show d-block " tabindex="-1" role="dialog" >

    <div class=" modal-backdrop fade show"> </div>

    <!-- Top Up Modal-->
    <div class=" modal-dialog" style="z-index:1050;margin-top:6rem">
        <EditForm Enhance Model="VacationType" OnSubmit="SubmitSanction">
            <DataAnnotationsValidator/>
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title">@Titel Vacation-Type</div>
                    <button type="button" class=" btn btn-close fs-6" @onclick="CancelButton"></button>
                </div>
                <div class=" modal-body">
                    <div class=" form-group">
                        <label class=" form-label"> Vacation Type Name</label>
                        <InputText class=" form-control" @bind-Value="VacationType.Name"/>
                        <ValidationMessage For="@(()=>VacationType.Name)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" hstack gap-2">
                        <button type="button" class=" btn btn-primary" @onclick="CancelButton">Cancel</button>
                        <button type="submit" class=" btn btn-success">@Button</button>
                    </div>
                </div>
            </div>

        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<VacationType, Task> FuncVacation { get; set; } = d => Task.CompletedTask;
    [Parameter] public VacationType VacationType { get; set; } = new();
    [Parameter] public String Button { get; set; } = string.Empty;
    [Parameter] public String Titel { get; set; } = string.Empty;

    // Cancel Button
    private async Task CancelButton() => await BlazoredModal.CloseAsync();
    // Vacation Submit
    private async Task SubmitSanction(EditContext context)
    {
        if (context.Validate())
        {
            await BlazoredModal.CloseAsync();
            await FuncVacation.Invoke(VacationType);
        }
    }

}
