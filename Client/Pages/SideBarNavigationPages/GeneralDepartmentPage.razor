@using BaseLibrary.Entities
@using BaseLibrary.Responses
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@implements IDisposable
@inject AllState allState
@inject IGenericModal<GeneralDepartment> InputDialog
@inject IDialogModal Dialog

@if (allState.ShowGeneralDepartment)
{
    <div class=" container mt-4">
        <div class=" row">
            <div class=" col-12">
                <div class=" card">
                    <div class=" card-header">
                        <h4 class=" float-start fs-4 text-center m-0">General Department</h4>
                        <button type="button" class=" btn  btn-out float-end " @onclick="Add" ><i class=" fs-3 bi bi-plus-circle"></i></button>
                    </div>
                    <div class=" card-body " style="overflow-x:hidden; overflow-y:scroll; max-height:390px">
                        <table class=" table table-striped">
                            <thead>
                                <tr >
                                    <th scope="col">#</th>
                                    <th scope="col">first</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!GeneralDepartments.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No data available</td>
                                    </tr>
                                }
                                else
                                {
                                    var i = 0;
                                    @foreach (var item in GeneralDepartments)
                                    {

                                        <tr>
                                            <th scope="col">@(++i)</th>
                                            <td>@item.Name</td>
                                            <td>
                                                <button type="button" class="btn btn-primary " @onclick="() => Edit(item)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Edit</span>
                                                </button>
                                            </td>
                                            <td>
                                                <button type="button" class=" btn btn-primary" @onclick="() => Delete(item)">
                                                    <i class="bi bi-trash"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

    </div>

}
<style>
    a.text-decoration-none:hover , a.text-decoration-none:focus {
        text-decoration: underline;

    }
</style>

@code {
    public List<GeneralDepartment> GeneralDepartments { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;

        await GetAll();

    }

    // Get All general departments
    private async Task GetAll()
    {
        GeneralDepartments = await generalDepartmentService.GetAll(ContantsBaseUrl.GeneralDepartmentUrl);
        allState.Action?.Invoke();
    }

    // Add general department
    private void Add()
    {
        InputDialog.ShowDialog(AddGeneralDepartment,"Create","Create");

    }
    private async Task AddGeneralDepartment(GeneralDepartment generalDepartment)
    {
        var response = await generalDepartmentService.Create(generalDepartment, ContantsBaseUrl.GeneralDepartmentUrl);
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success":"Error", response.Message);
    }

    // Edit general department
    private void Edit(GeneralDepartment generalDepartment)
    {
        InputDialog.ShowDialog(EditGeneralDepartment, generalDepartment, "Edit","Edit");
    }
    private async Task EditGeneralDepartment(GeneralDepartment generalDepartment)
    {
        var response = await generalDepartmentService.Update(generalDepartment, $"{ContantsBaseUrl.GeneralDepartmentUrl}/{generalDepartment.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Delete general department
    private void Delete(GeneralDepartment generalDepartment)
    {
        Dialog.ShowDialog("Alert", $"Are you sure you want to delete {generalDepartment.Name} department?",async () => await DeleteGeneralDepartment(generalDepartment));
    }
    private async Task DeleteGeneralDepartment(GeneralDepartment generalDepartment)
    {
        var response = await generalDepartmentService.DeleteById($"{ContantsBaseUrl.GeneralDepartmentUrl}/{generalDepartment.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }


    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}
