@page "/home/dashboard"
@inject NavigationManager NavManager
@using Client.Pages.TablePages


<TableBanner/>

<button @onclick="Click">Click</button>
<div>@Element</div>

@code{

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; }
    private string Element { get; set; } = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        await CheckUserAuthenticadAsync();
    }

    private async Task CheckUserAuthenticadAsync()
    {
        var user = (await AuthenticationState!).User;
        if (!user.Identity!.IsAuthenticated)
        {
            NavManager.NavigateTo("/identity/account/login", forceLoad: true);
        }
    }
    private void Click()
    {
        Element = string.IsNullOrEmpty(Element) ? "<h1>Hello</h1>" : "";
    }
}