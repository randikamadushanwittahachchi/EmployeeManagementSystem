@using BaseLibrary.Entities
@using BaseLibrary.Responses
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject AllState allState
@inject IGenericModal<City> CityDialog
@inject IDialogModal Dialog
@implements IDisposable

@if (allState.ShowCity)
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="float-start fs-4 text-center m-0">City</h4>
                        <button type="button" class="btn btn-out float-end" @onclick="Add"><i class="fs-3 bi bi-plus-circle"></i></button>
                    </div>
                    <div class="card-body" style="overflow-x:hidden; overflow-y:scroll; max-height:390px">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">City</th>
                                    <th scope="col">Country</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Cities.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No data available</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Cities)
                                    {
                                        <tr>
                                            <th scope="col">@item.Id</th>
                                            <td>@item.Name</td>
                                            <td>@(item.Country?.Name ?? "None")</td>
                                            <td>
                                                <a type="button" class="text-primary text-decoration-none" @onclick="()=>Edit(item)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Edit</span>
                                                </a>
                                            </td>
                                            <td>
                                                <button type="button" class="border-0 m-0 p-0 btn btn-link" @onclick="()=>Delete(item)">
                                                    <i class="bi bi-trash"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
}

<style>
    a.text-decoration-none:hover, a.text-decoration-none:focus {
        text-decoration: underline;
    }
</style>

@code {
    public List<City> Cities { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;

        await GetAll();

    }

    // Get All Cities
    private async Task GetAll()
    {
        Cities = await cityService.GetAll(ContantsBaseUrl.CityUrl);
        allState.Action?.Invoke();
    }

    // Add City
    private void Add()
    {
        CityDialog.ShowDialog(AddCity, "Create", "Create");

    }
    private async Task AddCity(City city)
    {
        var response = await cityService.Create(city, ContantsBaseUrl.CityUrl);
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Edit City    
    private void Edit(City city)
    {
        CityDialog.ShowDialog(EditCity, city, "Edit", "Edit");
    }
    private async Task EditCity(City city)
    {
        var response = await cityService.Update(city, $"{ContantsBaseUrl.CityUrl}/{city.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Delete City  
    private void Delete(City city)
    {
        Dialog.ShowDialog("Alert", $"Are you sure you want to delete {city.Name} department?", async () => await DeleteCity(city));
    }
    private async Task DeleteCity(City city)
    {
        var response = await cityService.DeleteById($"{ContantsBaseUrl.CityUrl}/{city.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }


    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}
