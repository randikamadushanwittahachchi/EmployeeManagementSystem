@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject IDialogModal Dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="Town" Enhance OnSubmit="SubmitDepartment">
            <DataAnnotationsValidator />
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title"> @Titel Town</div>
                    <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
                </div>
                <div class="modal-body">
                    <div class=" form-group ">
                        <label class=" form-label">Name</label>
                        <input type="text" class="bg-light form-control" @bind="Town.Name" />
                    </div>
                    <div class=" form-group">
                        <label class=" form-label"> Country</label>
                        <select class="bg-light form-select" onchange="@OnChangeCounrty">
                            @if (!DefaultCounrtys.Any())
                            {
                                <option value="@none"> Country Data not available</option>
                            }
                            else
                            {
                                <option value="@none"> None</option>
                                @foreach (var defaultCountry in DefaultCounrtys)
                                {
                                    <option value="@defaultCountry.Id">@defaultCountry.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label"> City </label>
                        <select class="bg-light form-select" @bind="Town.CityId">
                            @if (!SelectedCitys.Any())
                            {
                                <option value="">No Cities available</option>
                            }
                            else
                            {
                                <option value="">None</option>
                                @foreach (var item in SelectedCitys)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" d-flex gap-2 ">
                            <button type="button" class="  btn btn-secondary " @onclick="CancelClick">Cancel</button>
                            <button type="submit" class=" btn btn-primary">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<Town, Task>? FunTown { get; set; }
    [Parameter] public string Titel { get; set; } = string.Empty;
    [Parameter] public string Button { get; set; } = string.Empty;
    [Parameter] public Town Town { get; set; } = new();

    private List<Country> DefaultCounrtys { get; set; } = new();
    private List<City> DefaultCitys { get; set; } = new();
    private List<City> SelectedCitys { get; set; } = new();

    private int selecedCountryId;
    private int none = -1;


    protected override async Task OnInitializedAsync()
    {
        DefaultCounrtys = await countryService.GetAll(ContantsBaseUrl.CountryUrl);
        DefaultCitys = await cityService.GetAll(ContantsBaseUrl.CityUrl);
    }

    private void OnChangeCounrty(ChangeEventArgs e)
    {
        if(int.TryParse(e.Value!.ToString() , out selecedCountryId))
        {
            SelectedCitys = DefaultCitys.Where(c => c.CountryId == selecedCountryId).ToList();
        }
        allState.Action!.Invoke();
    }

    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    }

    private async Task SubmitDepartment()
    {
        if (string.IsNullOrWhiteSpace(Town.Name)) { await BlazoredModal.CloseAsync(); Dialog.ShowDialog("Error", "Please enter a valid Town name."); }
        else { await BlazoredModal.CloseAsync(); await FunTown!.Invoke(Town); }

    }

}