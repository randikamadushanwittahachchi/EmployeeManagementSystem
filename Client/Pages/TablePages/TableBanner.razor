<div class="container ">
    <div class=" row">
        <div class="col cursor-pointer">
            <button type="button" class=" btn btn-outline-secondary" @onclick="EmployeePageClick">
                <div class=" hstack gap-2">
                    <i class=" bi bi-people text-dark "></i>
                    <span class ="d-none d-md-inline">Employee</span>  
                </div>
            </button>
        </div>
        <div class="col cursor-pointer ">
            <button type="button" class=" btn btn-outline-secondary" @onclick="VacationPageClick">
                <div class=" hstack gap-2">
                    <i class=" bi bi-stopwatch text-dark "></i>
                    <span class="d-none d-md-inline">Vacation</span>
                </div>
            </button>
        </div>
        <div class="col cursor-pointer ">
            <button type="button" class=" btn btn-outline-secondary" @onclick="OverTimePageClick">
                <div class=" hstack gap-2">
                    <i class=" bi bi-hospital text-dark "></i>
                    <span class=" d-none d-md-inline">OverTime</span>
                </div>
            </button>
        </div>
        <div class="col cursor-pointer ">
            <button type="button" class=" btn btn-outline-secondary" @onclick="DoctorPageClick">
                <div class=" hstack gap-2">
                    <i class=" bi bi-hospital text-dark "></i>
                    <span class=" d-none d-md-inline">Doctor</span>
                </div>
            </button>
        </div>
        <div class="col cursor-pointer ">
            <button type="button" class=" btn btn-outline-secondary" @onclick="SanctionPageClick">
                <div class=" hstack gap-2">
                    <i class=" bi bi-crosshair text-dark "></i>
                    <span class=" d-none d-md-inline">Sanction</span>
                </div>
            </button>
        </div>
    </div>
</div>

@code{
    private void EmployeePageClick() => allState.EmployeeClick();
    private void DoctorPageClick() => allState.DoctorClick();
    private void VacationPageClick() => allState.VacationClick();
    private void OverTimePageClick() => allState.OverTimeClick();
    private void SanctionPageClick() => allState.SanctionClick();
}