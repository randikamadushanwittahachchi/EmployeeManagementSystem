@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject IDialogModal Dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="City" Enhance OnSubmit="SubmitDepartment">
            <DataAnnotationsValidator />
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title"> @Titel City</div>
                    <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
                </div>
                <div class="modal-body">
                    <div class=" form-group ">
                        <label class=" form-label">Name</label>
                        <InputText type="text" class="bg-light form-control" @bind-Value="City.Name" />
                        <ValidationMessage For="@(()=>City.Name)"/>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label"> Country </label>
                        <select class="form-select bg-light" @bind="City.CountryId">
                            @if (!Countries.Any())
                            {
                                <option value="">No Countries available</option>
                            }
                            else
                            {
                                <option value="">None</option>
                                @foreach (var item in Countries)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(()=>City.CountryId)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" d-flex gap-2 ">
                            <button type="button" class="  btn btn-secondary " @onclick="CancelClick">Cancel</button>
                            <button type="submit" class=" btn btn-primary">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<City, Task>? FunCity { get; set; }
    [Parameter] public City City { get; set; } = new();
    [Parameter] public List<Country> Countries { get; set; } = new();
    [Parameter] public string Titel { get; set; } = string.Empty;
    [Parameter] public string Button { get; set; } = string.Empty;


    protected override async Task OnInitializedAsync() => await GetAll();

    // Cancel Button
    private async Task CancelClick() => await BlazoredModal.CloseAsync();

    // Sumbit Button
    private async Task SubmitDepartment(EditContext context)
    {
        if (context.Validate()) 
        {
            await BlazoredModal.CloseAsync();
            await FunCity!.Invoke(City);
        }
    }
    private async Task GetAll() => Countries = await countryService.GetAll(ContantsBaseUrl.CountryUrl);
}