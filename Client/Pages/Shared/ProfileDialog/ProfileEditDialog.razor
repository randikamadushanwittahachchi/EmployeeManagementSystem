@using Blazored.Modal
<div class=" modal fade show d-block" role="dialog" tabindex="-1">
    <div class=" modal-backdrop fade show"></div>

    <!-- Pop up Modal-->
    <div class=" modal-dialog" style=" z-index:1050;margin-top:6rem">
        <EditForm Enhance Model="ManageUser" OnSubmit="SubmitManageUser">
            <DataAnnotationsValidator />
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title">@Titel User </div>
                    <button type="button" class=" btn btn-close fs-6" @onclick="CancelButton"></button>
                </div>
                <div class=" modal-body">
                    <div class=" form-group">
                        <label class=" form-label">User Name</label>
                        <InputText class=" form-control" @bind-Value="ManageUser.UserName" />
                        <ValidationMessage For="@(() => ManageUser.UserName)" />
                    </div>
                    <div class=" form-group">
                        <label class=" form-label">User Email</label>
                        <InputText class=" form-control" @bind-Value="ManageUser.Email" />
                        <ValidationMessage For="@(() => ManageUser.Email)" />
                    </div>
                    <div class=" form-group">
                        <label class=" form-label">User Role</label>
                        <input disabled class=" form-control" @bind="ManageUser.Role" />
                        <ValidationMessage For="@(() => ManageUser.Role)" />
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" hstack gap-2 ">
                            <button type="button" class=" btn btn-primary" @onclick="CancelButton">Cancel</button>
                            <button type="submit" class=" btn btn-success">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public String Titel { get; set; } = string.Empty;
    [Parameter] public String Button { get; set; } = string.Empty;
    [Parameter] public ManageUser ManageUser { get; set; } = new();
    [Parameter] public Func<ManageUser, Task> FuncManageUser { get; set; } = d => Task.CompletedTask;

    // Submit Sanction Type
    private async Task SubmitManageUser(EditContext context)
    {
        if (context.Validate())
        {
            await BlazoredModal.CloseAsync();
            await FuncManageUser.Invoke(ManageUser);
        }
    }
    // Cancel Button
    private async Task CancelButton() => await BlazoredModal.CloseAsync();
}
