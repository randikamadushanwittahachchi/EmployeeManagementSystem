@using Blazored.Modal
@using Client.Helper.Constracts
@using Client.Helper.Implementations
@using ClientLibrary.Constants
@inject EmployeeModal employeeDialog
@inject ViewModal viewModal
@inject IDialogModal dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class=" modal-backdrop fade show"></div>
    <div class=" modal-dialog" style="margin-top:6rem; z-index:1050">
        <div class=" modal-content">
            <div class=" modal-header">
                <h5 class=" modal-title">Menu</h5>
                <button class=" btn btn-close fs-6" type="button" @onclick="@CancelClick">Cancel</button>
            </div>
            <div class=" modal-body">
                <div class=" container">
                    <div class=" row">
                        <div class=" col ps-2">
                            <button type="button" @onclick="@ViewEmployee" class=" d-flex btn btn-link btn-light align-items-center mb-2">
                                <i class="bi bi-eye me-2"></i> View
                            </button>
                            <button type="button" @onclick="@(()=>Edit(Employee))" class=" d-flex btn btn-link btn-light align-items-center mb-2">
                                <i class="bi bi-pen me-2"></i> Edit
                            </button>
                            <button type="button" @onclick="@DeleteEmployee" class=" d-flex btn btn-link btn-light align-items-center mb-2">
                                <i class="bi bi-trash3 me-2"></i> Delete
                            </button> 
                        </div>
                    </div>
                </div>
            </div>
            <div class=" modal-footer"></div>
        </div>

    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Employee Employee { get; set; } = null!;

    private async Task CancelClick()
    {
        await BlazoredModal.CancelAsync();
    }
    // View Employee
    private async Task ViewEmployee()
    {
        await BlazoredModal.CancelAsync();
        viewModal.ShowModal(Employee);
    }
    // Edit Employee
    private async Task Edit(Employee employee)
    {
        await BlazoredModal.CancelAsync();
        employeeDialog.ShowDialog(EditEmployee, employee, "Edit", "Edit");
    }
    private async Task EditEmployee(Employee employee)
    {
        var response = await employeeService.Update(employee, ContantsBaseUrl.EmployeeUrl);
        dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }
    // Delete Employee
    private async Task DeleteEmployee()
    {
        await BlazoredModal.CancelAsync();
        // dialog.ShowDialog()
    }

}
