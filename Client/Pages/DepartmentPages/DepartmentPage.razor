@using BaseLibrary.Entities
@using BaseLibrary.Responses
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@implements IDisposable
@inject AllState allState
@inject IModalDropdwonDialog DropdwonDialog
@inject IModalDialog Dialog

@if (allState.ShowDepartment)
{
    <div class=" container mt-4">
        <div class=" row">
            <div class=" col-12">
                <div class=" card">
                    <div class=" card-header">
                        <h4 class=" float-start fs-4 text-center m-0">Department</h4>
                        <button type="button" class=" btn  btn-out float-end " @onclick="Add"><i class=" fs-3 bi bi-plus-circle"></i></button>
                    </div>
                    <div class=" card-body " style=" max-height:500px; overflow-x:hidden; overflow-y:scroll; max-height:390px">
                        <table class=" table table-striped">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Depatment</th>
                                    <th scope="col">General Department</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Departments.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">No data available</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Departments)
                                    {
                                        <tr>
                                            <th scope="col">@item.Id</th>
                                            <td>@item.Name</td>
                                            <td>@(item.GeneralDepartment?.Name ?? "None")</td>
                                            <td>
                                                <a type="button" class="text-primary text-decoration-none " @onclick="()=>Edit(item)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Edit</span>
                                                </a>
                                            </td>
                                            <td>
                                                <button type="button" class=" border-0 m-0 p-0 btn btn-link " @onclick="()=>Delete(item)">
                                                    <i class="bi bi-trash"></i>
                                                    <span>Delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

    </div>

}
<style>
    a.text-decoration-none:hover, a.text-decoration-none:focus {
        text-decoration: underline;
    }
</style>

@code {
    public List<Department> Departments { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        allState.Action += StateHasChanged;

        await GetAll();

    }

    // Get All departments
    private async Task GetAll()
    {
        Departments = await departmentService.GetAll(ContantsBaseUrl.DepartmentUrl);
        allState.Action?.Invoke();
    }

    // Add department
    private void Add()
    {
        DropdwonDialog.ShowDialog(AddDepartment, "Add");

    }
    private async Task AddDepartment(Department department)
    {
        var response = await departmentService.Create(department, ContantsBaseUrl.DepartmentUrl);
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Edit department
    private void Edit(Department department)
    {
        DropdwonDialog.ShowDialog(EditDepartment, department, "Edit");
    }
    private async Task EditDepartment(Department department)
    {
        var response = await departmentService.Update(department, $"{ContantsBaseUrl.DepartmentUrl}/{department.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }

    // Delete department
    private void Delete(Department department)
    {
        Dialog.ShowDialog("Alert", $"Are you sure you want to delete {department.Name} department?", async () => await DeleteDepartment(department));
    }
    private async Task DeleteDepartment(Department department)
    {
        var response = await departmentService.DeleteById($"{ContantsBaseUrl.DepartmentUrl}/{department.Id}");
        if (response.Flag) await GetAll();
        Dialog.ShowDialog(response.Flag ? "Success" : "Error", response.Message);
    }


    public void Dispose()
    {
        allState.Action -= StateHasChanged;
    }
}
