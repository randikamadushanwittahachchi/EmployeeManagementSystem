@using Blazored.Modal
<div class="modal fade show d-block" role="dialog" tabindex="-1">
    <div class=" modal-backdrop fade show"></div>

    <!--Pop Up Dialog-->
    <div class=" modal-dialog" style="margin-top:6rem;z-index:1050">
        <EditForm Enhance Model="DoctorType" OnSubmit="SubmitDoctorType">
            <DataAnnotationsValidator/>

            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title">@Titel Doctor Type</div>
                    <button class=" btn btn-close fs-6" type="button" @onclick="CancelButton"></button>
                </div>
                <div class=" modal-body">
                    <div class=" form-group">
                        <label class=" form-label">Name</label>
                        <InputText class=" form-control" @bind-Value="DoctorType.Name"/>
                        <ValidationMessage For="@(()=>DoctorType.Name)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1  ">
                    <div class=" form-group  ">
                        <div class=" hstack gap-2">
                            <button type="button" class=" btn btn-primary" @onclick="CancelButton">Cancel</button>
                            <button type="submit" class=" btn btn-success">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance blazoredModal { get; set; } = default!;
    [Parameter] public Func<DoctorType, Task> FuncDoctorType { get; set; } = d => Task.CompletedTask;
    [Parameter] public DoctorType DoctorType { get; set; } = new();
    [Parameter] public String Titel { get; set; } = String.Empty;
    [Parameter] public String Button { get; set; } = String.Empty;

    private List<DoctorType> DoctorTypes { get; set; } = new();

    // Cancel Button
    private async Task CancelButton()
    {
        await blazoredModal.CancelAsync();
    }

    // Submit Button
    private async Task SubmitDoctorType(EditContext context)
    {
        if (context.Validate())
        {
            await FuncDoctorType.Invoke(DoctorType);
            await blazoredModal.CloseAsync();
        }
    }
}
