@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject IDialogModal Dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="Department" Enhance OnSubmit="SubmitDepartment">
            <DataAnnotationsValidator />
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title"> @Titel Deparment</div>
                    <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
                </div>
                <div class="modal-body">
                    <div class=" form-group ">
                        <label class=" form-label">Name</label>
                        <InputText type="text" class=" bg-light form-control" @bind-Value="Department.Name" />
                        <ValidationMessage For="@(()=>Department.Name)"/>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label">General Department</label>
                        <select class="form-select bg-light" @bind="Department.GeneralDepartmentId">
                            @if (!GeneralDepartments.Any())
                            {
                                <option value="">No General Departments available</option>
                            }
                            else
                            {
                                <option value="">None</option>
                                @foreach (var item in GeneralDepartments)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(()=>Department.GeneralDepartmentId)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" d-flex gap-2 ">
                            <button type="button" class="  btn btn-secondary " @onclick="CancelClick">Cancel</button>
                            <button type="submit" class=" btn btn-primary">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<Department, Task>? FuncDepartment { get; set; }
    [Parameter] public Department Department { get; set; } = new();
    [Parameter] public List<GeneralDepartment> GeneralDepartments { get; set; } = new();
    [Parameter] public string Titel { get; set; } = string.Empty;
    [Parameter] public string Button { get; set; } = string.Empty;


    protected override async Task OnInitializedAsync() => await GetAll();
    // Cancel Button
    private async Task CancelClick() => await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    // Sumbit Button
    private async Task SubmitDepartment(EditContext context)
    {
        if (context.Validate()) { await BlazoredModal.CloseAsync(); await FuncDepartment!.Invoke(Department); }
    }
    // Load Data
    private async Task GetAll() => GeneralDepartments = await generalDepartmentService.GetAll(ContantsBaseUrl.GeneralDepartmentUrl);

}