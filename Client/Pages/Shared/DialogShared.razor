@using Blazored.Modal
@using Blazored.Modal.Services

<div>
    <div class=" pb-3 px-1 d-flex justify-content-between">
        <h4 class=" mb-0 text-center fs-5">@Header</h4>
        <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
    </div>
    <div class="border-top py-3">
        <p class="m-0">@Message</p>
    </div>
    <div class="border-top pt-3 d-flex g-3 ">
        <button type="button" class=" btn btn-primary" @onclick="OkClick">ok</button>
        <button type="button" class=" btn btn-secondary ms-2" @onclick="CancelClick">cancel</button>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public string? Header { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public Func<Task>? FuncTask { get; set; }
    [Parameter] public Action? Action { get; set; }

    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    }
    private async Task OkClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
        await FuncTask!.Invoke();
        Action!.Invoke();
    }

}