@using Blazored.Modal
<div class=" modal fade show d-block" role="dialog" tabindex="-1">
    <div class=" modal-backdrop fade show" ></div>

    <!-- Pop up Modal-->
    <div class=" modal-dialog" style=" z-index:1050;margin-top:6rem">
        <EditForm Enhance Model="SanctionType" OnSubmit="SubmitSanctionType">
            <DataAnnotationsValidator/>
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title">@Titel Sanction Type</div>
                    <button type="button" class=" btn btn-close fs-6" @onclick="CancelButton"></button>
                </div>
                <div class=" modal-body">
                    <div class=" form-group">
                        <label class=" form-label">Sanction-Type Name</label>
                        <InputText class=" form-control" @bind-Value="SanctionType.Name"/>
                        <ValidationMessage For="@(()=>SanctionType.Name)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" hstack gap-2 ">
                            <button type="button" class=" btn btn-primary" @onclick="CancelButton">Cancel</button>
                            <button type="submit" class=" btn btn-success">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public String Titel { get; set; } = string.Empty;
    [Parameter] public String Button { get; set; } = string.Empty;
    [Parameter] public SanctionType SanctionType { get; set; } = new(); 
    [Parameter] public Func<SanctionType, Task> FuncSanctionType { get; set; } = d => Task.CompletedTask;

    // Submit Sanction Type
    private async Task SubmitSanctionType(EditContext context)
    {
        if (context.Validate())
        {
            await BlazoredModal.CloseAsync();
            await FuncSanctionType.Invoke(SanctionType);
        }
    }
    // Cancel Button
    private async Task CancelButton() => await BlazoredModal.CloseAsync();
}
