@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject IDialogModal Dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="ManageUser" Enhance OnSubmit="SubmitManageUser">
            <DataAnnotationsValidator />
            <div class="modal-content">
                <div class=" modal-header ">
                    <h5 class=" modal-title ">Alert</h5>
                    <button @onclick="CancelClick" type="button" class="btn btn-close fs-6 "></button>
                </div>
                <div class="modal-body">
                    <p class=" bg-light">Are You Sure, You want Authurize This Use</p>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" @bind-Value="ManageUser.IsAutherize" />
                        <label class="form-check-label">Authorize</label>
                        <ValidationMessage For="@(() => ManageUser.IsAutherize)" />
                    </div>
                </div>
                <div class=" modal-footer ">
                    <button type="button" class=" btn btn-secondary ms-2" @onclick="CancelClick">cancel</button>
                    <button type="submit" class=" btn btn-primary">Submit</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<ManageUser, Task> FuncManageUser { get; set; } = d => Task.CompletedTask;
    [Parameter] public ManageUser ManageUser { get; set; } = new();

    private List<ManageUser> ManageUsers { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        await GetAll();
    }

    // Get All
    private async Task GetAll()
    {
        ManageUsers = await manageUserService.GetAll(ContantsBaseUrl.ManageUserUrl);
    }

    // Sumbit Button
    private async Task SubmitManageUser(EditContext context)
    {
        if (context.Validate()) { await BlazoredModal.CloseAsync(); await FuncManageUser!.Invoke(ManageUser); }
    }

    // Cancel Button
    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync();
    }


}