@using Blazored.Modal
@using Blazored.Modal.Services  

<div class=" modal fade show d-block " tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <div class="modal-content">
            <div class=" modal-header ">
                <h5 class=" modal-title ">@Header</h5>
                <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
            </div>
            <div class="modal-body">
                <p >@Message</p>
            </div>
            <div class=" modal-footer ">
                <button style="visibility:@CssButtonVisibility" type="button" class=" btn btn-secondary ms-2" @onclick="CancelClick">cancel</button>
                <button  type="button" class=" btn btn-primary" @onclick="OkClick">ok</button>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public string? Header { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public Func<Task>? TaskCallBack { get; set; }
    [Parameter] public Action? CallBack { get; set; }

    private string? CssButtonVisibility { get; set; } = "visible";

    protected override void OnInitialized()
    {
        if (TaskCallBack == null && CallBack == null )
        {
            CssButtonVisibility = "hidden";
        }
    }

    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    }
    private async Task OkClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
        if (TaskCallBack != null)
        {
            await TaskCallBack!.Invoke();
        }
        if (CallBack != null)
        {
            CallBack!.Invoke();
        }
    }

}