@using Blazored.Modal
@using ClientLibrary.Constants
<div class=" modal fade show d-block " tabindex="-1" role="dialog">
    <div class=" modal-backdrop fade show "></div>
    <div class=" modal-dialog" style=" margin-top:6rem;z-index:1050">
        <div class=" modal-content">
            <div class=" modal-header">
                <h5 class=" modal-title ">@Employee.Name Employee Details</h5>
            </div>
            <div class=" modal-body">
                <div class=" container">
                    <div class=" row">
                        @*  column one *@ 
                        <div class=" col me-3">
                            @* Persanel Information *@
                            <h5 class=" mb-3">Personal Information</h5>
                            <div class=" row mb-2">
                                <img class=" border rounded-circle shadow " src="@Employee.Photo" width="100"/>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col fw-normal">Name</div>
                                <div class=" col ">@Employee.Name</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col fw-normal">Job Titel</div>
                                <div class=" col ">@Employee.JobName</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col fw-normal">Telephone</div>
                                <div class=" col">@Employee.TelephoneNumber</div>
                            </div>
                        </div>

                        @* column two *@
                        <div class=" col me-3 ">
                            @* Department Information*@
                            <h5 class="mb-3">Department Infermation</h5>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">General Department</div>
                                <div class=" col ">@GeneralDepartment.Name</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">Department</div>
                                <div class=" col">@Department.Name</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">Branch</div>
                                <div class=" col ">@Branch.Name</div>
                            </div>
                        </div>

                        @* column three*@
                        <div class=" col me-3">
                            @* Location Information*@
                            <h5 class=" mb-3" >Location Information</h5>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">Country</div>
                                <div class=" col ">@Country.Name</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">City</div>
                                <div class=" col ">@City.Name</div>
                            </div>
                            <div class=" row mb-2">
                                <div class=" col  fw-normal">Town</div>
                                <div class=" col ">@Town.Name</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class=" modal-footer">
                <button @onclick="@OnClickCancel" type="button" class=" btn btn-close ">Ok</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Employee Employee { get; set; } = new();
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;


    // Department Loaded
    private Branch Branch { get; set; } = new();
    private Department Department { get; set; } = new();
    private GeneralDepartment GeneralDepartment { get; set; } = new();

    //Location Loaded
    private Town Town { get; set; } = new();
    private City City { get; set; } = new();
    private Country Country { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OnClickCancel()
    {
        await BlazoredModal.CancelAsync();
    }

    private async Task LoadData()
    {
        // Load Branch / Department / GeneralDepartment
        var branchResponse = await branchService.GetById($"{ContantsBaseUrl.BranchUrl}/{Employee.BranchId}");
        if (branchResponse.Flag) Branch = branchResponse.Data!;
        var departmentResponse = await departmentService.GetById($"{ContantsBaseUrl.DepartmentUrl}/{Branch.DepartmentId}");
        if (departmentResponse.Flag) Department = departmentResponse.Data!;
        GeneralDepartment = Department.GeneralDepartment!;

        //Load Town / City / Country
        var townResponse = await townService.GetById($"{ContantsBaseUrl.TownUrl}/{Employee.TownId}");
        if (townResponse.Flag) Town = townResponse.Data!;
        var cityResponse = await cityService.GetById($"{ContantsBaseUrl.CityUrl}/{Town.CityId}");
        if (cityResponse.Flag) City = cityResponse.Data!;
        Country = City.Country!;
    }


}
