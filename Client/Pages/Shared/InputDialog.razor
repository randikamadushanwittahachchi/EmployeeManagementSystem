@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@inject IModalDialog Dialog

<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="GeneralDepartment" Enhance OnSubmit="SubmitDepartment">
            <DataAnnotationsValidator/>
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title">Enter Deparment</div>
                    <button @onclick="CancelClick" type="button" class="btn btn-close close-btn fs-6 "></button>
                </div>
                <div class="modal-body">
                    <div class=" form-group ">
                        <label class=" form-label">Name</label>
                        <input type="text" class=" form-control" @bind="GeneralDepartment.Name" />
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" d-flex gap-2 ">
                            <button type="button" class="  btn btn-secondary " @onclick="CancelClick">Cancel</button>
                            <button type="submit" class=" btn btn-primary">Sumbit</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<GeneralDepartment, Task>? SaveGeneralDepartment { get; set; }
    [Parameter] public GeneralDepartment GeneralDepartment { get; set; } = new();

    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    }

    private async Task SubmitDepartment()
    {
        if (string.IsNullOrWhiteSpace(GeneralDepartment.Name)) { await BlazoredModal.CloseAsync(); Dialog.ShowDialog("Error", "Please enter a valid department name."); }
        else { await BlazoredModal.CloseAsync(); await SaveGeneralDepartment!.Invoke(GeneralDepartment); }
        
    }

}