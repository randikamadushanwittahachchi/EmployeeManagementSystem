@using BaseLibrary.Responses
@using Blazored.Modal
@using Blazored.Modal.Services
@using BaseLibrary.Entities
@using Client.Helper.Constracts
@using ClientLibrary.Constants
@inject IDialogModal Dialog


<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class="modal-backdrop fade show"></div>
    <!-- Pop it above the backdrop -->
    <div class="  modal-dialog " style="margin-top:6rem;z-index: 1050">
        <EditForm Model="Branch" Enhance OnSubmit="SubmitDepartment">
            <DataAnnotationsValidator />
            <div class=" modal-content">
                <div class=" modal-header py-4">
                    <div class=" modal-title"> @Titel Deparment</div>
                    <button @onclick="CancelClick" type="button" class="btn btn-close fs-6 "></button>
                </div>
                <div class="modal-body">
                    <div class=" form-group ">
                        <label class=" form-label">Name</label>
                        <InputText type="text" class="bg-light form-control" @bind-Value="Branch.Name" />
                        <ValidationMessage For="@(()=>Branch.Name)"/>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label">General Department</label>
                        <select class="bg-light form-select" @onchange="OnGeneralDepartmentChnage">
                            @if (!DefaultGeneralDepartments.Any())
                            {
                                <option value="@noneValue">No Data is avaible</option>
                            }
                            else
                            {
                                <option value="@noneValue">None</option>
                                @foreach (var generalDepartment in DefaultGeneralDepartments)
                                {
                                    <option value="@generalDepartment.Id">@generalDepartment.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label">Departments</label>
                        <select class="bg-light form-select" @bind="Branch.DepartmentId">
                            @if (!SelectedDepartments.Any())
                            {
                                <option value="@noneValue">No Departments available</option>
                            }
                            else
                            {
                                <option value="@noneValue">None</option>
                                @foreach (var item in SelectedDepartments)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                        <ValidationMessage For="@(()=>Branch.DepartmentId)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group ">
                        <div class=" d-flex gap-2 ">
                            <button type="button" class="  btn btn-secondary " @onclick="CancelClick">Cancel</button>
                            <button type="submit" class=" btn btn-primary">@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>


@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public Func<Branch, Task>? FunBranch { get; set; }
    [Parameter] public String Titel { get; set; } = string.Empty;
    [Parameter] public String Button { get; set; } = string.Empty;
    [Parameter] public Branch Branch { get; set; } = new();

    private List<Department> SelectedDepartments { get; set; } = new();
    private List<GeneralDepartment> DefaultGeneralDepartments { get; set; } = new();
    private List<Department> DefaultDepartment = new();
    private int defaultGeneralDepartmentId;
    private int noneValue = -1;

    protected override async Task OnInitializedAsync()
    {
        await GetAll();
    }
    private void OnGeneralDepartmentChnage(ChangeEventArgs e)
    {
        if(int.TryParse(e.Value!.ToString(), out defaultGeneralDepartmentId))
        {
            SelectedDepartments = DefaultDepartment.Where(d => d.GeneralDepartmentId == defaultGeneralDepartmentId).ToList();
        }
        allState.Action!.Invoke();
    }

    // Cancel Button
    private async Task CancelClick()
    {
        await BlazoredModal.CloseAsync();
    }

    // Submit Button
    private async Task SubmitDepartment(EditContext context)
    {
        if (context.Validate())
        {
            await BlazoredModal.CloseAsync();
            await FunBranch!.Invoke(Branch);
        }
    }

    // Load List
    private async Task GetAll()
    {
        DefaultGeneralDepartments = await generalDepartmentService.GetAll(ContantsBaseUrl.GeneralDepartmentUrl);
        DefaultDepartment = await departmentService.GetAll(ContantsBaseUrl.DepartmentUrl);
    }
}
