@using Client.State
@using ClientLibrary.Constants
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized Context="ctx">
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="" >
                    Welcome,@ctx.User.Identity!.Name
                </a>
                <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
        <div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
            <nav class="nav flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="home/dashboard" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>
                @if (ctx.User.IsInRole(ConstantRoles.Admin))
                {
                    <div class=" nav-item px-3">
                        <NavLink class=" nav-link cursor-pointer" href="administration" @onclick="ShowAdminMenuContainer">
                            <div class=" hstack gap-1">
                                <span class=" bi bi-people-fill fs-5 text-center" style=" margin-top:-2rem;" aria-hidden="true" ></span>
                                <span>Administration</span>
                            </div>
                        </NavLink>
                        @if (CssAdminVisibility is "visible")
                        {
                            <a class=" nav-link text-white p-2 " style=" margin-left:5rem">
                                <div class=" hstack">
                                    <span class=" bi bi-people fs-5 text-center " aria-hidden="true" style="margin-top:-2rem;"></span>
                                    <span>User</span>
                                </div>
                            </a>
                        }
                    </div>
                }
                @if (ctx.User.HasClaim(_ => _.Type == "IsAutherize" && _.Value == ConstantBool.True))
                {
                    <div class=" nav-item px-3">
                    <NavLink class=" nav-link cursor-pointer" @onclick="ShowDepartmentMenuContainer">
                        <div class=" hstack gap-1">
                            <span class=" bi bi-buildings-fill fs-5 text-center" aria-hidden="true" style="margin-top:-2rem"></span>
                            <span class=" fs-6">Deparment</span>
                        </div>
                    </NavLink>
                    @if (CssDeparmentVisibility is "visible")
                    {
                        <div class=" nav-link p-2 text-white" style=" margin-left:5rem">
                            <ul class="list-group" style="list-style:none;">
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="EmployeeClick">
                                        <div class=" hstack text-wrap">
                                            <span class=" bi bi-building fs-5 text-center" style="margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 text-truncate">Employee</span>
                                        </div>
                                    </a>
                                </li>
                                <hr />
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="GeneralClick">
                                        <div class=" hstack text-wrap">
                                            <span class=" bi bi-building fs-5 text-center" style="margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 text-truncate">General Department</span>
                                        </div>
                                    </a>
                                </li>
                                <li style="list-style:none" class=" cursor-pointer ">
                                    <a class=" nav-link p-2" @onclick="DepartmentClick">
                                        <div class=" hstack text-wrap">
                                            <span class="bi bi-house-door fs-5 text-center" style=" margin-top:-2rem" aria-hidden="true"></span>
                                            <span class=" fs-6">Department</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class="cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="BranchClick">
                                        <div class=" text-wrap hstack">
                                            <span class="bi bi-door-closed fs-5 text-center " style=" margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 ">Branch</span>
                                        </div>
                                    </a>
                                </li>
                                <hr />
                                <li style=" list-style:none" class="cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="CountryClick">
                                        <div class=" text-wrap hstack">
                                            <span class="bi bi-door-closed fs-5 text-center " style=" margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 ">County</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class="cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="CityClick">
                                        <div class=" text-wrap hstack">
                                            <span class="bi bi-door-closed fs-5 text-center " style=" margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 ">City</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class="cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="TownClick">
                                        <div class=" text-wrap hstack">
                                            <span class="bi bi-door-closed fs-5 text-center " style=" margin-top:-2rem;" aria-hidden="true"></span>
                                            <span class=" fs-6 ">Town</span>
                                        </div>
                                    </a>
                                </li>
                                <hr/>
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="DoctorTypeClick">
                                        <div class=" text-wrap hstack">
                                            <span class=" bi bi-door-closed fs-5 text-center" style=" margin-top:-2rem" aria-hidden="true"></span>
                                            <span class=" fs-6">Doctor Type</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="OverTimeTypeClick">
                                        <div class=" text-wrap hstack">
                                            <span class=" bi bi-door-closed fs-5 text-center" style=" margin-top:-2rem" aria-hidden="true"></span>
                                            <span class=" fs-6">Over-Time Type</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="SanctionTypeClick">
                                        <div class=" text-wrap hstack">
                                            <span class=" bi bi-door-closed fs-5 text-center" style=" margin-top:-2rem" aria-hidden="true"></span>
                                            <span class=" fs-6">Sanction Type</span>
                                        </div>
                                    </a>
                                </li>
                                <li style=" list-style:none" class=" cursor-pointer">
                                    <a class=" nav-link p-2" @onclick="VacationTypeClick">
                                        <div class=" text-wrap hstack">
                                            <span class=" bi bi-door-closed fs-5 text-center" style=" margin-top:-2rem" aria-hidden="true"></span>
                                            <span class=" fs-6">Vacation Type</span>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
                }
            </nav>
        </div>
    </Authorized>
</AuthorizeView>

 
@code {

    private bool collapseNavMenu = true;
    private string CssAdminVisibility{ get; set; } = "hidden";
    private string CssDeparmentVisibility { get; set; } = "hidden";
    // private string CssDepatmentMargin{ get; set; } = "-3.5rem";


    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    private void ShowAdminMenuContainer()
    {
        CssAdminVisibility = Toggel(CssAdminVisibility, "hidden", "visible");
        // CssDepatmentMargin = Toggel(CssDepatmentMargin, "-3.5rem", "0rem");

    }
    private void ShowDepartmentMenuContainer()
    {
        CssDeparmentVisibility = Toggel(CssDeparmentVisibility, "hidden", "visible");
    }

    // Genereal Department /Department/Branch Navigation Click
    private void GeneralClick() => allState.GeneralDepartmentClick();
    private void DepartmentClick() => allState.DepartmentClick();
    private void BranchClick() => allState.BranchClick();

    // Country/City/Town Navigation Click
    private void CountryClick() => allState.CountryClick();
    private void CityClick() => allState.CityClick();
    private void TownClick() => allState.TownClick();

    // OverTimeType / VacationType / SanctionType
    private void DoctorTypeClick() => allState.DoctorTypeClick();
    private void OverTimeTypeClick() => allState.OverTimeTypeClick();
    private void SanctionTypeClick() => allState.SanctionTypeClick();
    private void VacationTypeClick() => allState.VacationTypeClick();

    // User / Employee Navigation Click
    private void UserClick() => allState.ManageUserClick();
    private void EmployeeClick() => allState.EmployeeClick();

    // Toggle function
    private string Toggel(string value1, string value2, string value3)
    {
        return value1 == value2 ? value3 : value2;
    }


}
