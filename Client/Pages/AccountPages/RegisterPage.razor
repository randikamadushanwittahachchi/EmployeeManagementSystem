@page "/identity/account/register";
@layout AuthenticationLayout

<DialogShared @ref="DialogRef"></DialogShared>

<div class="container" style=" margin-top:2%; z-index:2">
    <div class="row justify-content-center">
        <div class="col-6">
            <EditForm Enhance Model="User" OnValidSubmit="RegisterHandler">
                <DataAnnotationsValidator />
                <div class="card-account">
                    <div class="card-header-account">
                        Register
                        <div class=" d-flex justify-content-center">
                            <img src="../images/logo/logo.jpeg" class="logo" />
                        </div>
                    </div>
                    <div class="card-body-account">
                        <div class=" form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text" class=" form-control" @bind="User.FullName" />
                        </div>
                        <div class=" form-group">
                            <label class="form-label">Email</label>
                            <input type="email" class=" form-control" @bind="User.Email" />
                        </div>
                        <div class=" form-group">
                            <label class=" form-label">Password</label>
                            <input type="password" class=" form-control" @bind="User.Password" />
                        </div>
                        <div class=" form-group">
                            <label class=" form-label">Password</label>
                            <input type="password" class=" form-control" @bind="User.ConfimPassword" />
                        </div>
                        <div class="mt-5 form-group">
                            @if (ButtonStates)
                            {
                                <Client.Pages.OtherPages.ButtonLoadingSpinerPage></Client.Pages.OtherPages.ButtonLoadingSpinerPage>
                            }
                            else
                            {
                                <button class=" btn btn-outline-primary float-end" type="submit">Register</button>
                            }
                        </div>
                    </div>
                    <div class="card-footer-account">
                        <span>
                            don't have account
                            <a class=" btn-link" href="/identity/account/login">Login</a>
                            <ValidationSummary />
                        </span>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>


@code{
    private bool ButtonStates { get; set; } = false;
    private Register User = new();

    private DialogShared? DialogRef;

    [CascadingParameter] public Task<AuthenticationState>? AuthenticationState { get; set; }
    protected async override Task OnInitializedAsync()
    {
        await CheckUserAuthenticadAsync();
    }

    async Task RegisterHandler()
    {
        ButtonStates = true;
        var result = await accountService.CreateAsync(User);
        if (result!.Flag) 
        {
            await DialogRef!.Show(result.Message, "Register Success");
            NavManager.NavigateTo("/", forceLoad: true);
            User = new();
        }
        else
        {
            await DialogRef!.Show(result.Message, "Alert");
        };
        ButtonStates = false;
    }

    private async Task CheckUserAuthenticadAsync()
    {
        var user = (await AuthenticationState!).User;
        if (user.Identity!.IsAuthenticated)
        {
            NavManager.NavigateTo("/home/dashboard", forceLoad: true);
        }
    }

    
}