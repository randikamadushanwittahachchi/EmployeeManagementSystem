@page "/home/dashboard"
@using Client.Pages.TablePages
@using Client.Pages.SideBarNavigationPages
@inject NavigationManager NavManager


<TableBanner/>
<GeneralDepartmentPage/>
<DepartmentPage />
<BranchPage />
<CountryPage />
<CityPage />
<TownPage/>
<ManageUserPage/>

@code{

    [CascadingParameter] public Task<AuthenticationState> AuthenticationState { get; set; } 
    private string Element { get; set; } = string.Empty;

    protected async override Task OnInitializedAsync()
    {
        await CheckUserAuthenticadAsync();
    }

    private async Task CheckUserAuthenticadAsync()
    {
        var user = (await AuthenticationState!).User;
        if (!user.Identity!.IsAuthenticated)
        {
            NavManager.NavigateTo("/identity/account/login", forceLoad: true);
        }
    }
}