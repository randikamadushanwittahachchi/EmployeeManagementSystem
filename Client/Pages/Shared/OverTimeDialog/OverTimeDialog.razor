@using Blazored.Modal
@using ClientLibrary.Constants
<div class=" modal fade show d-block" tabindex="-1" role="dialog">
    <div class=" modal-backdrop fade show"></div>

    <!-- Pop up Modal dialog-->
    <div class=" modal-dialog" style=" margin-top:6rem;z-index:1050;">
        <EditForm Model="OverTime" Enhance OnSubmit="SubmitOverTime">
            <DataAnnotationsValidator/>
            <div class=" modal-content">
                <div class=" modal-header">
                    <div class=" modal-title">@Titel Over Time</div>
                    <button type="button" class=" btn btn-close fs-6" @onclick="CancelButton"></button>
                </div>
                <div class=" modal-body">
                    <div class=" form-group">
                        <label class=" form-label"> Employee Name </label>
                        <input type="text" class=" form-control disabled" Value="@(OverTime?.Employee?.Name??Employee.Name)" disabled />
                    </div>
                    <div class=" form-group">
                        <label class=" form-label"> Start Date</label>
                        <InputDate class=" form-control" @bind-Value="OverTime!.StartDate"/>
                        <ValidationMessage For="@(() => OverTime.StartDate)"/>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label"> End Date</label>
                        <InputDate class=" form-control" @bind-Value="OverTime.EndDate"/>
                        <ValidationMessage For="@(() => OverTime.EndDate)"/>
                    </div>
                    <div class=" form-group">
                        <label class=" form-label" > Select Over Time Type</label>
                        <InputSelect class=" form-select" @bind-Value="OverTime.OverTimeTypeId">
                            @if (!OverTimeTypes.Any())
                            {
                                <option value="@None"> Over Time Type is Not Avaible</option>
                            }
                            else
                            {
                                <option value="@None"> None</option>
                                @foreach (var overTimeType in OverTimeTypes)
                                {
                                    <option value="@overTimeType.Id"> @overTimeType.Name</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(()=>OverTime.OverTimeTypeId)"/>
                    </div>
                </div>
                <div class=" modal-footer py-1">
                    <div class=" form-group">
                        <div class=" d-flex gap-2">
                            <button type="button" class=" btn btn-primary" @onclick="CancelButton"> Cancel</button>
                            <button type="submit" class=" btn btn-success" >@Button</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [Parameter] public String Titel { get; set; } = String.Empty;
    [Parameter] public OverTime OverTime { get; set; } = new();
    [Parameter] public Func<OverTime, Task> FuncOverTime { get; set; } = d => Task.CompletedTask;
    [Parameter] public Employee Employee { get; set; } = new();
    [Parameter] public String Button { get; set; } = String.Empty;

    private List<OverTimeType> OverTimeTypes { get; set; } = new();
    private int None { get; set; } = -1;

    protected override async Task OnInitializedAsync()
    {
        if(Employee.Id > 0)
        { 
            OverTime.EmployeeId = Employee.Id; 
        }
        await GetAll();
    }

    // Get All
    private async Task GetAll()
    {
        OverTimeTypes = await overTimeTypeService.GetAll(ContantsBaseUrl.OverTimeTypeUrl);
    }

    // Sumit Button
    private async Task SubmitOverTime(EditContext context)
    {
        if (context.Validate())
        {
            await BlazoredModal.CloseAsync();
            await FuncOverTime.Invoke(OverTime);
        }


    }
    // Cancel Buttom
    private async Task CancelButton() => await BlazoredModal.CloseAsync();
}
